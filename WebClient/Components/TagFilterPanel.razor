<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Filter</h2>
            @if (Selection.HasAnyFilter)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OnCleared">Clear</button>
            }
        </div>

        <label class="form-label" for="tag-keyword">Keyword</label>
        <input id="tag-keyword" class="form-control mb-3" autocomplete="off" placeholder="Tag name"
               @bind="@(Selection.Keyword)" @bind:event="oninput" @bind:after="OnKeyword" />

        <div class="mb-3">
            <div class="form-label">Books</div>
            @if (SelectedBooks().Count > 0)
            {
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var book in SelectedBooks())
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                aria-label="@($"Remove {book.Name}")"
                                @onclick="@(() => RemoveBook(book.Id))">
                            @(book.Name)
                            <span aria-hidden="true">×</span>
                        </button>
                    }
                </div>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm" aria-controls="filter-books" aria-expanded="@(Selection.BooksOpen)" @onclick="ToggleBooks">
                @(Selection.BooksOpen ? "Hide books" : "Choose books")
            </button>
            @if (Selection.BooksOpen)
            {
                <div id="filter-books" class="filter-scroll border rounded mt-2 p-2">
                    @for (var testamentIndex = 0; testamentIndex < Testaments.Length; testamentIndex++)
                    {
                        var testament = Testaments[testamentIndex];
                        var rows = Catalog.Books.Where(book => book.Testament == testament).ToList();
                        if (rows.Count == 0)
                            continue;

                        var bookIds = rows.Select(book => book.Id).ToList();
                        <div class="@($"d-flex align-items-center gap-3 {(testamentIndex == 0 ? "mt-0" : "mt-3")} mb-2")">
                            <h3 class="h6 mb-0">@(testament)</h3>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="@($"filter-testament-{testamentIndex}")"
                                       aria-label="@($"Select all {testament} books")"
                                       checked="@(TestamentSelected(bookIds))"
                                       @onchange="@((ChangeEventArgs change) => SetTestament(bookIds, change))" />
                                <label class="form-check-label" for="@($"filter-testament-{testamentIndex}")">Select all</label>
                            </div>
                        </div>
                        <div class="filter-books">
                            @foreach (var book in rows)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"filter-book-{book.Id}")"
                                           checked="@(Selection.BookIds.Contains(book.Id))"
                                           @onchange="@((ChangeEventArgs change) => SetBook(book.Id, change))" />
                                    <label class="form-check-label" for="@($"filter-book-{book.Id}")">@(book.Name)</label>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <label class="form-label mb-0" for="tag-add">Tags</label>
            <div class="d-flex gap-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" name="tag-match" id="tag-match-and"
                           checked="@(!Selection.MatchAnyTag)"
                           @onchange="@(() => SetMatch(false))" />
                    <label class="form-check-label" for="tag-match-and">And</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" name="tag-match" id="tag-match-or"
                           checked="@(Selection.MatchAnyTag)"
                           @onchange="@(() => SetMatch(true))" />
                    <label class="form-check-label" for="tag-match-or">Or</label>
                </div>
            </div>
        </div>
        @if (Selection.SelectedTags.Count > 0)
        {
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var tag in Selection.SelectedTags)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            title="@(Catalog.Index.PathOf(tag.Id))"
                            aria-label="@($"Remove {Catalog.ChipText(tag)}")"
                            @onclick="@(() => RemoveTag(tag.Id))">
                        @(Catalog.ChipText(tag))
                        <span aria-hidden="true">×</span>
                    </button>
                }
            </div>
        }
        <input id="tag-add" class="form-control" autocomplete="off" placeholder="Add a tag, such as Isaac"
               @bind="@(Selection.TagQuery)" @bind:event="oninput" @bind:after="OnTagQuery" @onkeydown="OnTagKeyDown" />
        <div class="form-text">@(Selection.MatchAnyTag ? "Any selected tag may be on the verse." : "Every selected tag must be on the verse.") A tag stays when it shares those verses. The number is the count of those verses.</div>
        @if (Selection.Suggestions.Count > 0)
        {
            <div class="list-group mt-2">
                @foreach (var tag in Selection.Suggestions)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2 text-start"
                            @onclick="@(() => PickTag(tag.Id))">
                        <span>@(Catalog.Index.PathOf(tag.Id))</span>
                        <span class="badge text-bg-secondary">@(tag.VerseCount)</span>
                    </button>
                }
            </div>
        }

        @if (Topics.Topics.Count > 0)
        {
            <div class="mt-3">
                <div class="form-label">Topics</div>
                @if (ChosenTopics().Count > 0)
                {
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var topic in ChosenTopics())
                        {
                            var topicCode = topic.Code;
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    aria-label="@($"Remove {topic.Title}")"
                                    @onclick="@(() => RemoveTopic(topicCode))">
                                @(topic.Title): @(TopicChoice(topic.Code))
                                <span aria-hidden="true">×</span>
                            </button>
                        }
                    </div>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm" aria-controls="filter-topics" aria-expanded="@(Selection.TopicsOpen)" @onclick="ToggleTopics">
                    @(Selection.TopicsOpen ? "Hide topics" : "Choose topics")
                </button>
                @if (Selection.TopicsOpen)
                {
                    <div id="filter-topics" class="filter-scroll border rounded mt-2 p-2">
                        <div class="form-text mb-2">Yes or No keeps verses with that answer. None leaves the topic out. Each chosen topic must match.</div>
                        @foreach (var topic in Topics.Topics)
                        {
                            var topicCode = topic.Code;
                            var topicId = topic.Id;
                            <div class="mb-2">
                                <div>@(topic.Title)</div>
                                <div class="d-flex gap-3">
                                    @foreach (var choice in TopicChoices)
                                    {
                                        var selected = choice;
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="radio" name="@($"topic-filter-{topicId}")" id="@($"topic-filter-{topicId}-{selected}")"
                                                   checked="@(TopicChoice(topicCode) == selected)"
                                                   @onchange="@(() => SetTopic(topicCode, selected))" />
                                            <label class="form-check-label" for="@($"topic-filter-{topicId}-{selected}")">@(selected)</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    static readonly string[] Testaments = [BibleBookRow.OldTestament, BibleBookRow.NewTestament];
    static readonly string[] TopicChoices = ["Yes", "No", "None"];

    [Parameter, EditorRequired]
    public TagFilterSelection Selection { get; set; } = null!;

    [Parameter, EditorRequired]
    public TagCatalog Catalog { get; set; } = null!;

    [Parameter, EditorRequired]
    public TopicCatalog Topics { get; set; } = null!;

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback Cleared { get; set; }

    List<BibleBookRow> SelectedBooks() =>
        Catalog.Books.Where(book => Selection.BookIds.Contains(book.Id)).ToList();

    void ToggleBooks() => Selection.BooksOpen = !Selection.BooksOpen;

    void ToggleTopics() => Selection.TopicsOpen = !Selection.TopicsOpen;

    List<TopicRow> ChosenTopics() =>
        Topics.Topics.Where(topic => Selection.TopicAnswers.ContainsKey(topic.Code)).ToList();

    void OnKeyword() => Changed.InvokeAsync();

    bool TestamentSelected(List<int> bookIds) =>
        bookIds.Count > 0 && bookIds.TrueForAll(Selection.BookIds.Contains);

    void SetBook(int bookId, ChangeEventArgs change)
    {
        if (change.Value is true)
            Selection.BookIds.Add(bookId);
        else
            Selection.BookIds.Remove(bookId);

        Changed.InvokeAsync();
    }

    void SetTestament(List<int> bookIds, ChangeEventArgs change)
    {
        if (change.Value is true)
        {
            foreach (var bookId in bookIds)
                Selection.BookIds.Add(bookId);
        }
        else
        {
            foreach (var bookId in bookIds)
                Selection.BookIds.Remove(bookId);
        }

        Changed.InvokeAsync();
    }

    void RemoveBook(int bookId)
    {
        Selection.BookIds.Remove(bookId);
        Changed.InvokeAsync();
    }

    string TopicChoice(string code) =>
        Selection.TopicAnswers.TryGetValue(code, out var answer) ? answer : "None";

    void RemoveTopic(string code) => SetTopic(code, "None");

    void SetTopic(string code, string choice)
    {
        if (choice == "None")
            Selection.TopicAnswers.Remove(code);
        else
            Selection.TopicAnswers[code] = choice;

        Changed.InvokeAsync();
    }

    void SetMatch(bool matchAny)
    {
        if (Selection.MatchAnyTag == matchAny)
            return;

        Selection.MatchAnyTag = matchAny;
        Changed.InvokeAsync();
    }

    void PickTag(int id)
    {
        if (!Selection.TagIds.Contains(id))
            Selection.TagIds.Add(id);

        Selection.TagQuery = "";
        Selection.Suggestions = [];
        Changed.InvokeAsync();
    }

    void RemoveTag(int id)
    {
        Selection.TagIds.Remove(id);
        Changed.InvokeAsync();
    }

    void OnTagQuery() => Selection.RefreshSuggestions(Catalog);

    void OnTagKeyDown(KeyboardEventArgs key)
    {
        if (key.Key == "Escape")
        {
            Selection.TagQuery = "";
            Selection.Suggestions = [];
            return;
        }

        if (key.Key == "Enter" && Selection.Suggestions.Count > 0)
            PickTag(Selection.Suggestions[0].Id);
    }

    void OnCleared() => Cleared.InvokeAsync();
}
