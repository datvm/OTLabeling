<div class="list-group-item">
    <div class="d-flex gap-3">
        <div class="text-secondary text-nowrap">@(VerseNumber)</div>
        <div class="flex-grow-1">
            <div class="verse-text">@(Text)</div>
            @if (Tags.Count > 0 && GroupParents && Index is not null && TagsById is not null)
            {
                <div class="verse-tag-groups mt-2">
                    @foreach (var group in TagParentGroups.Build(Tags, Index, TagsById))
                    {
                        <div class="d-flex flex-wrap align-items-center">
                            @for (var index = 0; index < group.Parents.Count; index++)
                            {
                                var parent = group.Parents[index];
                                @if (index > 0)
                                {
                                    <span class="text-secondary mx-1" aria-hidden="true">@(">")</span>
                                }
                                <a class="@(TagClass(parent.Id))" href="@(TagHref(parent.Id))">@(parent.Label)</a>
                            }
                            @if (group.Parents.Count > 0)
                            {
                                <span class="text-secondary">@(":")</span>
                            }
                            @foreach (var leaf in group.Leaves)
                            {
                                <a class="@(TagClass(leaf.Id)) ms-1" href="@(TagHref(leaf.Id))">@(leaf.Label)</a>
                            }
                        </div>
                    }
                </div>
            }
            else if (Tags.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var chain in Tags)
                    {
                        <span class="d-inline-flex flex-wrap align-items-center gap-1">
                            @for (var index = 0; index < chain.Count; index++)
                            {
                                var tag = chain[index];
                                @if (index > 0)
                                {
                                    <span class="text-secondary" aria-hidden="true">›</span>
                                }
                                <a class="@(TagClass(tag.Id))" href="@(TagHref(tag.Id))">@(tag.Label)</a>
                            }
                        </span>
                    }
                </div>
            }
            @if (Topics.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var topic in Topics)
                    {
                        <a class="@(TopicClass(topic.Answer))" href="@($"topics/{Uri.EscapeDataString(topic.Code)}")" title="@(topic.Tip)">@(topic.Title)</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public int VerseNumber { get; set; }

    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    [Parameter]
    public IReadOnlyList<List<VerseTagRef>> Tags { get; set; } = [];

    [Parameter]
    public IReadOnlyList<VerseTopicChip> Topics { get; set; } = [];

    [Parameter]
    public int? ActiveTagId { get; set; }

    [Parameter]
    public Func<int, string>? TagLink { get; set; }

    [Parameter]
    public bool GroupParents { get; set; }

    [Parameter]
    public TagIndex? Index { get; set; }

    [Parameter]
    public IReadOnlyDictionary<int, VerseTagRow>? TagsById { get; set; }

    string TagHref(int id) => TagLink?.Invoke(id) ?? $"tags/{id}";

    string TagClass(int id) =>
        id == ActiveTagId
            ? "badge border text-decoration-none text-bg-primary"
            : "badge border text-decoration-none text-bg-light text-dark";

    static string TopicClass(string answer) =>
        answer == "Yes"
            ? "badge text-decoration-none text-bg-dark"
            : "badge border text-decoration-none text-bg-light text-dark";
}
