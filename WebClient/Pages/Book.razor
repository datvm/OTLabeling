@page "/books/{Code}"
@inject LabelingDatabase Db
@inject NavigationManager Nav

<PageTitle>@(book?.Name ?? Code)</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@(error)</div>
    <a class="btn btn-outline-secondary" href="">Back to books</a>
}
else if (book is null)
{
    <p class="text-secondary mb-0">
        <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading @(Code)...
    </p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="">Books</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(book.Name)</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="h3 mb-0">@(book.Name)</h1>
            @foreach (var label in book.Labels)
            {
                <span class="badge text-bg-secondary">@(label)</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="chapter">Chapter</label>
            <select id="chapter" class="form-select" style="width: auto" @onchange="@(OnChapterChanged)">
                @if (chapter is null)
                {
                    <option value="" selected>All</option>
                }
                else
                {
                    <option value="">All</option>
                }
                @foreach (var item in chapters)
                {
                    if (item == chapter)
                    {
                        <option value="@(item)" selected>@(item)</option>
                    }
                    else
                    {
                        <option value="@(item)">@(item)</option>
                    }
                }
            </select>
        </div>
    </div>

    @if (verses is null)
    {
        <p class="text-secondary mb-0">
            <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading verses...
        </p>
    }
    else if (verses.Count == 0)
    {
        <p class="text-secondary mb-0">@(chapter is null ? "This book has no verses." : "This chapter has no verses.")</p>
    }
    else
    {
        @foreach (var group in verses.GroupBy(verse => verse.Chapter))
        {
            <h2 class="h5 mt-4">Chapter @(group.Key)</h2>
            <div class="list-group">
                @foreach (var verse in group)
                {
                    <VerseRow VerseNumber="@(verse.VerseNumber)" Text="@(verse.Text)" Tags="@(verse.Tags)" />
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public string Code { get; set; } = "";

    [SupplyParameterFromQuery(Name = "chapter")]
    public string? RequestedChapter { get; set; }

    BibleBookRow? book;
    List<int> chapters = [];
    List<BibleVerseRow>? verses;
    int? chapter;
    string? loadedCode;
    string? loadedChapterRequest;
    string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCode == Code && loadedChapterRequest == RequestedChapter && book is not null)
            return;

        var sameBook = loadedCode == Code && book is not null && error is null;
        loadedCode = Code;
        loadedChapterRequest = RequestedChapter;
        error = null;

        try
        {
            if (!sameBook)
            {
                book = null;
                verses = null;
                chapters = [];
                book = await Db.GetBookByCodeAsync(Code);
                if (book is null)
                {
                    error = $"No book has code {Code}.";
                    return;
                }

                chapters = (await Db.GetChaptersAsync(book.Id)).ToList();
            }

            var showAll = string.Equals(RequestedChapter, "all", StringComparison.OrdinalIgnoreCase);
            if (showAll)
                chapter = null;
            else if (int.TryParse(RequestedChapter, out var requested) && chapters.Contains(requested))
                chapter = requested;
            else
                chapter = chapters.Count > 0 ? chapters[0] : null;

            verses = null;
            await LoadVersesAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    void OnChapterChanged(ChangeEventArgs e)
    {
        if (book is null)
            return;

        var value = e.Value?.ToString();
        var next = string.IsNullOrEmpty(value) ? "all" : value;
        Nav.NavigateTo($"books/{book.Code}?chapter={next}");
    }

    async Task LoadVersesAsync()
    {
        if (book is null)
            return;

        var rows = chapter is int number
            ? await Db.GetVersesAsync(book.Id, number)
            : await Db.GetVersesAsync(book.Id);
        verses = rows.ToList();
    }
}
