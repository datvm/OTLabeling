@page "/tags/{Id:int}"
@inject LabelingDatabase Db
@inject TagCatalog Catalog
@inject NavigationManager Navigation

<PageTitle>@(tag?.Label ?? "Tag")</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@(error)</div>
    <a class="btn btn-outline-secondary" href="@(selection.Href("tags", Catalog.Loaded ? Catalog.Books : []))">Back to tags</a>
}
else if (tag is null)
{
    <p class="text-secondary mb-0">
        <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading tag...
    </p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@(selection.Href("tags", Catalog.Books))">Tags</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(tag.Label)</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">@(tag.Label)</h1>
        @if (verses is not null)
        {
            <span class="badge text-bg-secondary">@(verses.Count)</span>
        }
    </div>

    @if (parents.Count > 0)
    {
        <p class="mb-3">
            @foreach (var parent in parents)
            {
                <a class="badge text-bg-light border text-decoration-none me-1" href="@(TagHref(parent.Id))">@(parent.Label)</a>
            }
        </p>
    }

    <TagFilterPanel Selection="@(selection)" Catalog="@(Catalog)" Changed="@(OnFilterChanged)" Cleared="@(OnCleared)" />

    @if (verses is null)
    {
        <p class="text-secondary mb-0">
            <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading verses...
        </p>
    }
    else if (verses.Count == 0)
    {
        <p class="text-secondary mb-0">@(selection.HasVerseFilter ? "No verses match this filter." : "This tag has no verses.")</p>
    }
    else
    {
        @if (bookIds.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExpandAll">Expand all</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CollapseAll">Collapse all</button>
            </div>
        }
        <Virtualize Items="@(rows)" Context="row" ItemSize="@(64)" OverscanCount="@(12)">
                @if (row.Kind == TagListKind.Book)
                {
                    <div @key="@(row.Key)" class="d-flex flex-wrap align-items-baseline gap-2 tag-list-book">
                        <h2 class="h5 mb-0">
                            <a href="@($"books/{row.BookCode}")">@(row.BookName)</a>
                        </h2>
                        <span class="badge text-bg-secondary">@(row.Count)</span>
                        <ExpandLink Open="@(row.Open)" OnToggle="@(BookToggle(row.BookId))" />
                    </div>
                }
                else if (row.Kind == TagListKind.Chapter)
                {
                    <div @key="@(row.Key)" class="d-flex flex-wrap align-items-baseline gap-2 py-1">
                        <a href="@($"books/{row.BookCode}?chapter={row.Chapter}")">Chapter @(row.Chapter)</a>
                        <span class="badge text-bg-secondary">@(row.Count)</span>
                        <ExpandLink Open="@(row.Open)" OnToggle="@(ChapterToggle(row.ChapterKey))" />
                    </div>
                }
                else if (row.Verse is TaggedVerseRow verse)
                {
                    <div @key="@(row.Key)">
                        <VerseRow VerseNumber="@(verse.VerseNumber)" Text="@(verse.Text)" Tags="@(verse.Tags)" ActiveTagId="@(tag.Id)" TagLink="@(TagHref)" GroupParents="@(true)" Index="@(Catalog.Index)" TagsById="@(Catalog.TagsById)" />
                    </div>
                }
        </Virtualize>
    }
}

@code {
    readonly TagFilterSelection selection = new();

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? KeywordQuery { get; set; }

    [SupplyParameterFromQuery(Name = "books")]
    public string[]? BookQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tags")]
    public int[]? TagQueryIds { get; set; }

    [SupplyParameterFromQuery(Name = "op")]
    public string? OperatorQuery { get; set; }

    VerseTagRow? tag;
    List<VerseTagRef> parents = [];
    List<TaggedVerseRow>? allVerses;
    List<TaggedVerseRow>? verses;
    List<TagListRow> rows = [];
    List<int> bookIds = [];
    List<string> chapterKeys = [];
    HashSet<int> closedBooks = [];
    HashSet<string> openChapters = [];
    int loadedId;
    int loadVersion;
    string? writtenHref;
    string? error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await Catalog.LoadAsync();
            var current = RelativeUri();
            var ownNavigation = writtenHref is not null
                && selection.MatchesLocation(current, PagePath(), Catalog.Books)
                && selection.MatchesLocation(writtenHref, PagePath(), Catalog.Books);
            if (!ownNavigation)
            {
                selection.ApplyQuery(KeywordQuery, BookQuery, TagQueryIds, OperatorQuery, Catalog.Books, Catalog.TagsById);
                writtenHref = current;
            }

            if (loadedId != Id)
                await LoadTag();
            else if (!ownNavigation)
                ShowVerses();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task LoadTag()
    {
        var version = ++loadVersion;
        var requestedId = Id;
        error = null;
        tag = null;
        parents = [];
        allVerses = null;
        verses = null;
        rows = [];
        bookIds = [];
        chapterKeys = [];
        closedBooks = [];
        openChapters = [];

        var row = await Db.GetVerseTagAsync(requestedId);
        if (version != loadVersion)
            return;

        if (row is null)
        {
            error = $"No tag has id {requestedId}.";
            return;
        }

        var parentRows = (await Db.GetVerseTagParentsAsync(requestedId)).ToList();
        if (version != loadVersion)
            return;

        var verseRows = (await Db.GetVersesForTagAsync(requestedId)).ToList();
        if (version != loadVersion)
            return;

        loadedId = requestedId;
        tag = row;
        parents = parentRows;
        allVerses = verseRows;
        ShowVerses();
    }

    void OnFilterChanged()
    {
        ShowVerses();
        selection.RefreshSuggestions(Catalog);
        SyncUrl();
    }

    void OnCleared()
    {
        selection.Clear(Catalog.TagsById);
        OnFilterChanged();
    }

    void ShowVerses()
    {
        if (allVerses is null || !Catalog.Loaded)
            return;

        Catalog.Apply(selection.BookIds, selection.TagIds, selection.MatchAnyTag);
        verses = allVerses.Where(MatchesFilter).ToList();
        RebuildRows();
    }

    void RebuildRows()
    {
        var next = new List<TagListRow>();
        var nextBookIds = new List<int>();
        var nextChapterKeys = new List<string>();
        if (verses is not null)
        {
            var index = 0;
            while (index < verses.Count)
            {
                var book = verses[index];
                var bookStart = index;
                while (index < verses.Count && verses[index].BookId == book.BookId)
                    index++;

                var bookOpen = !closedBooks.Contains(book.BookId);
                nextBookIds.Add(book.BookId);
                next.Add(new TagListRow
                {
                    Kind = TagListKind.Book,
                    Key = $"b{book.BookId}",
                    BookId = book.BookId,
                    BookCode = book.BookCode,
                    BookName = book.BookName,
                    Count = index - bookStart,
                    Open = bookOpen,
                });

                var chapterIndex = bookStart;
                while (chapterIndex < index)
                {
                    var chapter = verses[chapterIndex];
                    var chapterStart = chapterIndex;
                    while (chapterIndex < index && verses[chapterIndex].Chapter == chapter.Chapter)
                        chapterIndex++;

                    var chapterKey = $"{book.BookId}:{chapter.Chapter}";
                    nextChapterKeys.Add(chapterKey);
                    if (!bookOpen)
                        continue;

                    var chapterOpen = openChapters.Contains(chapterKey);
                    next.Add(new TagListRow
                    {
                        Kind = TagListKind.Chapter,
                        Key = "c" + chapterKey,
                        BookId = book.BookId,
                        BookCode = book.BookCode,
                        Chapter = chapter.Chapter,
                        ChapterKey = chapterKey,
                        Count = chapterIndex - chapterStart,
                        Open = chapterOpen,
                    });
                    if (!chapterOpen)
                        continue;

                    for (var verseIndex = chapterStart; verseIndex < chapterIndex; verseIndex++)
                    {
                        var verse = verses[verseIndex];
                        next.Add(new TagListRow
                        {
                            Kind = TagListKind.Verse,
                            Key = $"v{book.BookId}:{chapter.Chapter}:{verse.VerseNumber}",
                            Verse = verse,
                        });
                    }
                }
            }
        }

        bookIds = nextBookIds;
        chapterKeys = nextChapterKeys;
        rows = next;
    }

    bool MatchesFilter(TaggedVerseRow verse)
    {
        if (selection.BookIds.Count > 0 && !selection.BookIds.Contains(verse.BookId))
            return false;

        if (selection.TagIds.Count == 0)
            return true;

        if (selection.MatchAnyTag)
        {
            foreach (var tagId in selection.TagIds)
            {
                if (VerseHas(verse, tagId))
                    return true;
            }

            return false;
        }

        foreach (var tagId in selection.TagIds)
        {
            if (!VerseHas(verse, tagId))
                return false;
        }

        return true;
    }

    bool VerseHas(TaggedVerseRow verse, int tagId)
    {
        foreach (var chain in verse.Tags)
        {
            foreach (var item in chain)
            {
                if (Catalog.Index.Covers(tagId, item.Id))
                    return true;
            }
        }

        return false;
    }

    void SyncUrl()
    {
        var path = PagePath();
        var href = selection.Href(path, Catalog.Books);
        if (selection.MatchesLocation(RelativeUri(), path, Catalog.Books))
        {
            writtenHref = href;
            return;
        }

        writtenHref = href;
        Navigation.NavigateTo(href, replace: true);
    }

    string PagePath() => $"tags/{Id}";

    string TagHref(int id) => selection.Href($"tags/{id}", Catalog.Books);

    string RelativeUri() => Navigation.ToBaseRelativePath(Navigation.Uri);

    EventCallback BookToggle(int bookId) =>
        EventCallback.Factory.Create(this, () => ToggleBook(bookId));

    void ToggleBook(int bookId)
    {
        if (!closedBooks.Add(bookId))
            closedBooks.Remove(bookId);

        RebuildRows();
    }

    EventCallback ChapterToggle(string key) =>
        EventCallback.Factory.Create(this, () => ToggleChapter(key));

    void ToggleChapter(string key)
    {
        if (!openChapters.Add(key))
            openChapters.Remove(key);

        RebuildRows();
    }

    void ExpandAll()
    {
        foreach (var bookId in bookIds)
            closedBooks.Remove(bookId);

        openChapters.Clear();
        foreach (var key in chapterKeys)
            openChapters.Add(key);

        RebuildRows();
    }

    void CollapseAll()
    {
        foreach (var bookId in bookIds)
            closedBooks.Add(bookId);

        openChapters.Clear();
        RebuildRows();
    }

    enum TagListKind
    {
        Book,
        Chapter,
        Verse,
    }

    sealed class TagListRow
    {
        public TagListKind Kind { get; init; }
        public string Key { get; init; } = "";
        public int BookId { get; init; }
        public string BookCode { get; init; } = "";
        public string BookName { get; init; } = "";
        public int Chapter { get; init; }
        public string ChapterKey { get; init; } = "";
        public int Count { get; init; }
        public bool Open { get; init; }
        public TaggedVerseRow? Verse { get; init; }
    }
}
