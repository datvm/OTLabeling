@page "/tags/{Id:int}"
@inject LabelingDatabase Db

<PageTitle>@(tag?.Label ?? "Tag")</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@(error)</div>
    <a class="btn btn-outline-secondary" href="tags">Back to tags</a>
}
else if (tag is null)
{
    <p class="text-secondary mb-0">
        <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading tag...
    </p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="tags">Tags</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(tag.Label)</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">@(tag.Label)</h1>
        <span class="badge text-bg-secondary">@(tag.VerseCount)</span>
    </div>

    @if (parents.Count > 0)
    {
        <p class="mb-3">
            @foreach (var parent in parents)
            {
                <a class="badge text-bg-light border text-decoration-none me-1" href="@($"tags/{parent.Id}")">@(parent.Label)</a>
            }
        </p>
    }

    @if (verses is null)
    {
        <p class="text-secondary mb-0">
            <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading verses...
        </p>
    }
    else if (verses.Count == 0)
    {
        <p class="text-secondary mb-0">This tag has no verses.</p>
    }
    else
    {
        @if (chapterKeys.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExpandAll">Expand all</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CollapseAll">Collapse all</button>
            </div>
        }
        @foreach (var bookGroup in verses.GroupBy(verse => verse.BookId))
        {
            var book = bookGroup.First();
            var bookCode = book.BookCode;
            var bookName = book.BookName;
            var bookId = book.BookId;
            <h2 class="h5 mt-4">
                <a href="@($"books/{bookCode}")">@(bookName)</a>
            </h2>
            @foreach (var chapterGroup in bookGroup.GroupBy(verse => verse.Chapter))
            {
                var chapterNumber = chapterGroup.Key;
                var chapterKey = $"{bookId}:{chapterNumber}";
                var chapterVerses = chapterGroup.ToList();
                var chapterOpen = openChapters.Contains(chapterKey);
                <div class="d-flex flex-wrap align-items-baseline gap-2 py-1">
                    <a href="@($"books/{bookCode}?chapter={chapterNumber}")">Chapter @(chapterNumber)</a>
                    <span class="badge text-bg-secondary">@(chapterVerses.Count)</span>
                    <ExpandLink Open="@(chapterOpen)" OnToggle="@(ChapterToggle(chapterKey))" />
                </div>
                @if (chapterOpen)
                {
                    <div class="list-group mb-3">
                        @foreach (var verse in chapterVerses)
                        {
                            <VerseRow VerseNumber="@(verse.VerseNumber)" Text="@(verse.Text)" Tags="@(verse.Tags)" ActiveTagId="@(tag.Id)" />
                        }
                    </div>
                }
            }
        }
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    VerseTagRow? tag;
    List<VerseTagRef> parents = [];
    List<TaggedVerseRow>? verses;
    List<string> chapterKeys = [];
    HashSet<string> openChapters = [];
    int? loadedId;
    string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id)
            return;

        loadedId = Id;
        error = null;
        tag = null;
        parents = [];
        verses = null;
        chapterKeys = [];
        openChapters = [];

        try
        {
            tag = await Db.GetVerseTagAsync(Id);
            if (tag is null)
            {
                error = $"No tag has id {Id}.";
                return;
            }

            parents = (await Db.GetVerseTagParentsAsync(Id)).ToList();
            verses = (await Db.GetVersesForTagAsync(Id)).ToList();
            chapterKeys = verses
                .Select(verse => $"{verse.BookId}:{verse.Chapter}")
                .Distinct(StringComparer.Ordinal)
                .ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    EventCallback ChapterToggle(string key) =>
        EventCallback.Factory.Create(this, () => ToggleChapter(key));

    void ToggleChapter(string key)
    {
        if (!openChapters.Add(key))
            openChapters.Remove(key);
    }

    void ExpandAll()
    {
        openChapters.Clear();
        foreach (var key in chapterKeys)
            openChapters.Add(key);
    }

    void CollapseAll() => openChapters.Clear();
}
