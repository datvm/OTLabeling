@page "/tags"
@inject LabelingDatabase Db

<PageTitle>Tags</PageTitle>

<h1 class="h3 mb-3">Tags</h1>

@if (tags is null)
{
    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@(error)</div>
    }
    else
    {
        <p class="text-secondary mb-0">
            <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading tags...
        </p>
    }
}
else if (tags.Count == 0)
{
    <p class="text-secondary mb-0">No tags yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var tag in tags)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" href="@($"tags/{tag.Id}")">
                @(tag.Name)
                <span class="badge text-bg-secondary">@(tag.VerseCount)</span>
            </a>
        }
    </div>
}

@code {
    List<VerseTagRow>? tags;
    string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tags = (await Db.GetVerseTagsAsync()).ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
