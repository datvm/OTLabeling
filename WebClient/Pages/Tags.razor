@page "/tags"
@inject TagCatalog Catalog
@inject NavigationManager Navigation

<PageTitle>Tags</PageTitle>

<h1 class="h3 mb-3">Tags</h1>

@if (!ready)
{
    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@(error)</div>
    }
    else
    {
        <p class="text-secondary mb-0">
            <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading tags...
        </p>
    }
}
else if (Catalog.Tags.Count == 0)
{
    <p class="text-secondary mb-0">No tags yet.</p>
}
else
{
    <TagFilterPanel Selection="@(selection)" Catalog="@(Catalog)" Changed="@(OnFilterChanged)" Cleared="@(OnCleared)" />

    @if (selection.HasVerseFilter)
    {
        <p class="text-secondary mb-3">@(MatchText())</p>
    }

    @if (roots.Count == 0)
    {
        <p class="text-secondary mb-0">No tags match.</p>
    }
    else
    {
        @if (panelPaths.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExpandAll">Expand all</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CollapseAll">Collapse all</button>
            </div>
        }
        <TagNodes Nodes="@(roots)"
                  ChildrenByParent="@(childrenByParent)"
                  PathPrefix="@("")"
                  IsOpen="@(IsPanelOpen)"
                  OnToggle="@(Toggle)"
                  LinkFor="@(TagHref)" />
    }
}

@code {
    readonly TagFilterSelection selection = new();

    List<VerseTagRow> roots = [];
    Dictionary<int, List<VerseTagRow>> childrenByParent = [];
    List<string> panelPaths = [];
    HashSet<string> openPaths = [];
    Dictionary<int, bool> visible = [];
    Dictionary<int, bool> underSelection = [];
    string term = "";
    string? writtenHref;
    bool ready;
    string? error;

    [SupplyParameterFromQuery(Name = "q")]
    public string? KeywordQuery { get; set; }

    [SupplyParameterFromQuery(Name = "books")]
    public string[]? BookQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tags")]
    public int[]? TagQueryIds { get; set; }

    [SupplyParameterFromQuery(Name = "op")]
    public string? OperatorQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Catalog.LoadAsync();
            selection.ApplyQuery(KeywordQuery, BookQuery, TagQueryIds, OperatorQuery, Catalog.Books, Catalog.TagsById);
            writtenHref = RelativeUri();
            Apply();
            ready = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    protected override void OnParametersSet()
    {
        if (!ready)
            return;

        var current = RelativeUri();
        if (writtenHref is not null && selection.MatchesLocation(current, "tags", Catalog.Books)
            && selection.MatchesLocation(writtenHref, "tags", Catalog.Books))
            return;

        writtenHref = current;
        if (!selection.ApplyQuery(KeywordQuery, BookQuery, TagQueryIds, OperatorQuery, Catalog.Books, Catalog.TagsById))
            return;

        Apply();
    }

    void OnFilterChanged()
    {
        Apply();
        selection.RefreshSuggestions(Catalog);
        SyncUrl();
    }

    void OnCleared()
    {
        selection.Clear(Catalog.TagsById);
        openPaths.Clear();
        OnFilterChanged();
    }

    void Apply()
    {
        Catalog.Apply(selection.BookIds, selection.TagIds, selection.MatchAnyTag);
        selection.SyncSelected(Catalog.TagsById);
        RebuildTree();
    }

    void SyncUrl()
    {
        var href = selection.Href("tags", Catalog.Books);
        if (selection.MatchesLocation(RelativeUri(), "tags", Catalog.Books))
        {
            writtenHref = href;
            return;
        }

        writtenHref = href;
        Navigation.NavigateTo(href, replace: true);
    }

    string TagHref(int id) => selection.Href($"tags/{id}", Catalog.Books);

    string RelativeUri() => Navigation.ToBaseRelativePath(Navigation.Uri);

    void RebuildTree()
    {
        term = selection.Keyword.Trim();
        visible.Clear();
        underSelection.Clear();

        var visibleIds = new HashSet<int>();
        foreach (var tag in Catalog.Tags)
        {
            if (IsVisible(tag.Id))
                visibleIds.Add(tag.Id);
        }

        childrenByParent = [];
        var childIds = new HashSet<int>();
        foreach (var link in Catalog.Links)
        {
            if (!visibleIds.Contains(link.TagId) || !visibleIds.Contains(link.ParentTagId))
                continue;

            childIds.Add(link.TagId);
            if (!childrenByParent.TryGetValue(link.ParentTagId, out var children))
            {
                children = [];
                childrenByParent.Add(link.ParentTagId, children);
            }

            children.Add(Catalog.TagsById[link.TagId]);
        }

        foreach (var children in childrenByParent.Values)
            children.Sort((left, right) => string.Compare(left.Label, right.Label, StringComparison.Ordinal));

        roots = Catalog.Tags
            .Where(tag => visibleIds.Contains(tag.Id) && !childIds.Contains(tag.Id))
            .OrderBy(tag => tag.Label, StringComparer.Ordinal)
            .ToList();
        panelPaths = [];
        CollectPaths(roots, "");
        if (term.Length > 0 || selection.TagIds.Count > 0)
        {
            foreach (var path in panelPaths)
                openPaths.Add(path);
        }
    }

    bool IsVisible(int id)
    {
        if (visible.TryGetValue(id, out var known))
            return known;

        visible[id] = false;
        var show = IsHit(id);
        if (!show)
        {
            foreach (var child in Catalog.Index.ChildrenOf(id))
            {
                if (IsVisible(child))
                {
                    show = true;
                    break;
                }
            }
        }

        visible[id] = show;
        return show;
    }

    bool IsHit(int id)
    {
        if (IsUnderSelection(id))
            return false;

        if (selection.HasVerseFilter && Catalog.Index.CountOf(id) == 0)
            return false;

        return term.Length == 0
            || Catalog.TagsById[id].Label.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    bool IsUnderSelection(int id)
    {
        if (selection.TagIds.Count == 0)
            return false;

        if (underSelection.TryGetValue(id, out var known))
            return known;

        underSelection[id] = false;
        foreach (var parent in Catalog.Index.ParentsOf(id))
        {
            if (selection.TagIds.Contains(parent) || IsUnderSelection(parent))
            {
                underSelection[id] = true;
                return true;
            }
        }

        return false;
    }

    void CollectPaths(IReadOnlyList<VerseTagRow> nodes, string prefix)
    {
        foreach (var tag in nodes)
        {
            if (PanelPath.Contains(prefix, tag.Id))
                continue;

            if (!childrenByParent.TryGetValue(tag.Id, out var children) || children.Count == 0)
                continue;

            var path = PanelPath.Combine(prefix, tag.Id);
            panelPaths.Add(path);
            CollectPaths(children, path);
        }
    }

    bool IsPanelOpen(string path) => openPaths.Contains(path);

    void Toggle(string path)
    {
        if (!openPaths.Add(path))
            openPaths.Remove(path);
    }

    void ExpandAll()
    {
        openPaths.Clear();
        foreach (var path in panelPaths)
            openPaths.Add(path);
    }

    void CollapseAll() => openPaths.Clear();

    string MatchText() => Catalog.MatchedVerseCount == 1
        ? "1 verse matches."
        : $"{Catalog.MatchedVerseCount} verses match.";
}
