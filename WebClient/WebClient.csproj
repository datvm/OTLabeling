<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="CopyLocalDatabase" BeforeTargets="AssignTargetPaths">
		<Copy SourceFiles="..\db\out\labeling.sqlite"
			  DestinationFiles="wwwroot\labeling.sqlite"
			  SkipUnchangedFiles="true"
			  Condition="Exists('..\db\out\labeling.sqlite')" />
	</Target>
</Project>
